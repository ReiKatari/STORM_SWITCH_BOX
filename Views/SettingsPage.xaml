<Page
    x:Class="StormSwitchBox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" MaxWidth="1000">
            
            <TextBlock x:Name="PageTitleText" Text="Параметры" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />

            <!-- ПЕРЕКЛЮЧАТЕЛЬ РАЗДЕЛОВ ПАРАМЕТРОВ (Общие / Switch / 3DS) -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GeneralTabButton" Click="GeneralTabButton_Click" Padding="18,10" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="GeneralTabIcon" Glyph="&#xE713;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="GeneralTabText" Text="Общие" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SwitchTabButton" Click="SwitchTabButton_Click" Padding="18,10" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="SwitchTabIcon" Glyph="&#xE7FC;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                        <TextBlock x:Name="SwitchTabText" Text="Nintendo Switch" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="Switch2TabButton" Click="Switch2TabButton_Click" Padding="18,10" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="Switch2TabIcon" Glyph="&#xE7FC;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                        <TextBlock x:Name="Switch2TabText" Text="Nintendo Switch 2" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThreeDsTabButton" Click="ThreeDsTabButton_Click" Padding="18,10" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="ThreeDsTabIcon" Glyph="&#xE7FC;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                        <TextBlock x:Name="ThreeDsTabText" Text="Nintendo 3DS" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 1. ВКЛАДКА: ОБЩИЕ НАСТРОЙКИ                -->
            <!-- ========================================== -->
            <StackPanel x:Name="GeneralSettingsPanel" Spacing="24">

                <!-- БЛОК: Язык интерфейса -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xF2B7;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="LangHeaderTxt" Text="Язык интерфейса" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="LangTitleTxt" Text="Язык интерфейса" FontWeight="Medium"/>
                                <TextBlock x:Name="LangDescTxt" Text="Выберите основной язык приложения (применяется мгновенно)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Right" Width="220" SelectionChanged="LanguageCombo_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="Русский" Tag="ru"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Deutsch" Tag="de"/>
                                <ComboBoxItem Content="Français" Tag="fr"/>
                                <ComboBoxItem Content="简体中文" Tag="zh"/>
                                <ComboBoxItem Content="한국어" Tag="ko"/>
                                <ComboBoxItem Content="日本語" Tag="ja"/>
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="Italiano" Tag="it"/>
                                <ComboBoxItem Content="Português" Tag="pt"/>
                                <ComboBoxItem Content="हिन्दी" Tag="hi"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Оформление и звуковые уведомления -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE771;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="AppearHeaderTxt" Text="Оформление и звуковые уведомления" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">

                            <!-- Visual Theme -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ThemeTitleTxt" Text="Тема оформления интерфейса" FontWeight="Medium"/>
                                    <TextBlock x:Name="ThemeDescTxt" Text="Выбор общей стилистической темы оформления приложения" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="220" SelectionChanged="ThemeCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="🌌 STORM MIDNIGHT" Tag="STORM MIDNIGHT"/>
                                    <ComboBoxItem Content="🔷 STORM DARK" Tag="STORM DARK"/>
                                    <ComboBoxItem Content="🖤 STORM NIGHT" Tag="STORM NIGHT"/>
                                    <ComboBoxItem Content="☀️ STORM DAY" Tag="STORM DAY"/>
                                    <ComboBoxItem Content="🟢 STORM MATRIX" Tag="STORM MATRIX"/>
                                    <ComboBoxItem Content="⚡ STORM CYBERPUNK" Tag="STORM CYBERPUNK"/>
                                    <ComboBoxItem Content="👑 STORM FANTASY" Tag="STORM FANTASY"/>
                                    <ComboBoxItem Content="⚜️ STORM WARHAMMER 40K" Tag="STORM WARHAMMER 40K"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Accent Color theme -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="AccentTitleTxt" Text="Цветовой акцент интерфейса" FontWeight="Medium"/>
                                    <TextBlock x:Name="AccentDescTxt" Text="Выбор главного акцентного цвета элементов приложения" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="AccentColorCombo" HorizontalAlignment="Right" Width="220" SelectionChanged="AccentColorCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Системный (Default)" Tag="Default"/>
                                    <ComboBoxItem Content="Электрический Синий" Tag="#0078D4"/>
                                    <ComboBoxItem Content="Изумрудный Зеленый" Tag="#107C41"/>
                                    <ComboBoxItem Content="Неоновый Фиолетовый" Tag="#8E44AD"/>
                                    <ComboBoxItem Content="Закат Оранжевый" Tag="#E67E22"/>
                                    <ComboBoxItem Content="Алый Красный" Tag="#E74C3C"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Sound notifications -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="SoundTitleTxt" Text="Звуковые уведомления" FontWeight="Medium"/>
                                    <TextBlock x:Name="SoundDescTxt" Text="Воспроизводить звуковой сигнал по окончании выполнения очереди задач" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="SoundToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.EnableSoundNotifications, Mode=TwoWay}" Toggled="Toggle_Changed"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Пути и организация файлов -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="FilesHeaderTxt" Text="Пути и организация файлов" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Комплексные имена -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ComplexTitleTxt" Text="Комплексное выходное имя файла по папкам" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ComplexDescTxt" Text="Создает удобные вложенные папки формата [Название Игры]/[Формат] с TitleID и версией в названии" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ComplexFoldersToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.ComplexFolders, Mode=TwoWay}" Toggled="Toggle_Changed"
                                              ToolTipService.ToolTip="Автоматически раскладывает готовые файлы по папкам и добавляет [TitleID] [vVersion] в имя файла."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Удалять исходники после успеха -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="DeleteSrcTitleTxt" Text="Удалять исходные файлы после успешной обработки" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DeleteSrcDescTxt" Text="Автоматически удаляет оригинальный входной файл после успешной конвертации или сборки" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="DeleteSourceToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.DeleteSourceOnSuccess, Mode=TwoWay}" Toggled="Toggle_Changed"
                                              ToolTipService.ToolTip="Экономит место на диске, удаляя исходники только после 100% безошибочного завершения."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Автозагрузка обложек всех консолей в локальный кэш (Чекбокс включения/отключения + очистка 12+ ГБ кэша) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <CheckBox x:Name="AutoDownloadCoversCheckBox"
                                              Content="Фоновая предзагрузка обложек всех игр и консолей на диск (офлайн-кэш)"
                                              IsChecked="{x:Bind Settings.AutoDownloadCovers, Mode=TwoWay}"
                                              Click="AutoDownloadCoversCheckBox_Click"
                                              FontWeight="Medium"/>
                                    <TextBlock x:Name="AutoDownloadCoversDescTxt"
                                               Text="По умолчанию отключено для экономии места на диске (полный кэш обложек 19 консолей может занимать до 12–14 ГБ в AppData\Local\StormSwitchBox\covers)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CoversCacheSizeTxt"
                                               Text="Размер локального кэша обложек: проверка..."
                                               FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ClearCoversCacheBtn" Content="🗑️ Очистить кэш обложек" Click="ClearCoversCacheBtn_Click" CornerRadius="6"/>
                                    <Button x:Name="OpenCoversFolderBtn" Content="📂 Папка кэша" Click="OpenCoversFolderBtn_Click" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Интеграция с эмуляторами (Путь к папке эмулятора) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="EmulatorHeaderTxt" Text="Интеграция с эмуляторами (Путь к папке эмулятора)" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="EmulatorPathTitleTxt" Text="Путь к папке эмулятора" FontWeight="Medium"/>
                                <TextBlock x:Name="EmulatorPathDescTxt" Text="Укажите одну или несколько папок эмуляторов (STORM SWITCH, Yuzu, Ryujinx, Suyu и др.) для автоматической синхронизации данных Homebrew (SDMC). Поддерживается Drag and Drop, выбор через диалог и ввод нескольких путей. Если указаны — программа использует только их, игнорируя остальные диски." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Drag & Drop DropZone for Emulator Folders -->
                            <Border x:Name="EmulatorDropZone" 
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1.5" 
                                    CornerRadius="8" 
                                    Padding="14" 
                                    AllowDrop="True" 
                                    DragOver="EmulatorDropZone_DragOver" 
                                    Drop="EmulatorDropZone_Drop">
                                <StackPanel Spacing="10">
                                    <ListView x:Name="EmulatorDirsListView" 
                                              SelectionMode="None" 
                                              MaxHeight="180" 
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xED25;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                    <Button Grid.Column="2" Click="RemoveEmulatorDir_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Margin="6,0,0,0" ToolTipService.ToolTip="Удалить путь">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#E74C3C"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="AddEmulatorDirBtn" Click="AddEmulatorDir_Click" Style="{StaticResource AccentButtonStyle}" Height="34" CornerRadius="6" Padding="14,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                                <TextBlock Text="Выбрать папку" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClearEmulatorDirsBtn" Click="ClearEmulatorDirs_Click" Height="34" CornerRadius="6" Padding="12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                                <TextBlock Text="Очистить все" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="💡 Или перетащите папки эмуляторов прямо сюда" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Производительность и сжатие -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="PerfHeaderTxt" Text="Производительность и сжатие" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Уровень сжатия -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="CompTitleTxt" Text="Уровень сжатия Zstandard (NSZ / XCZ)" FontWeight="Medium"/>
                                    <TextBlock x:Name="CompDescTxt" Text="Выбор уровня сжатия алгоритма Zstd (от Быстрого 3 до Ультра 22)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CompressionCombo" HorizontalAlignment="Right" Width="220" SelectionChanged="CompressionCombo_Changed" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Быстрое (уровень 3)" Tag="3"/>
                                    <ComboBoxItem Content="Баланс (уровень 10)" Tag="10"/>
                                    <ComboBoxItem Content="Стандарт (уровень 18)" Tag="18"/>
                                    <ComboBoxItem Content="Ультра (уровень 22)" Tag="22"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Одновременные задачи -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="TasksTitleTxt" Text="Максимум одновременных задач" FontWeight="Medium"/>
                                    <TextBlock x:Name="TasksDescTxt" Text="Количество задач, выполняемых одновременно в фоновой очереди (от 1 до 5)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox HorizontalAlignment="Right" Width="220" Value="{x:Bind Settings.ConcurrentTasks, Mode=TwoWay}" Minimum="1" Maximum="5" SpinButtonPlacementMode="Inline" ValueChanged="Setting_ValueChanged" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Многопоточность -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ThreadsTitleTxt" Text="Многопоточность (Используемые ядра)" FontWeight="Medium"/>
                                    <TextBlock x:Name="ThreadsDescTxt" Text="Максимальное количество ядер ЦП, выделяемых для ZstdSharp-сжатия" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox HorizontalAlignment="Right" Width="220" Value="{x:Bind Settings.UsedCores, Mode=TwoWay}" Minimum="1" Maximum="{x:Bind MaxCores, Mode=OneTime}" SpinButtonPlacementMode="Inline" ValueChanged="Setting_ValueChanged" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК: О программе -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="AboutHeaderTxt" Text="О программе" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="96" CornerRadius="12" Background="Transparent" Margin="0,0,24,0" VerticalAlignment="Top">
                                <Image Source="ms-appx:///Assets/logo.png" Stretch="Uniform" Width="96" Height="96"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppTitleVersionTxt" Text="STORM SWITCH BOX 6.9.3" FontWeight="Bold" FontSize="22"/>
                                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="WinUI 3 Native" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="AboutDescriptionTxt" Text="Специализированный комбайн для обработки, сжатия и конвертации игр Nintendo Switch и Nintendo 3DS. Проверка обновлений на GitHub и STORM GAMES WORLD." 
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" LineHeight="20" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                                    <Button x:Name="CheckUpdatesButton" Content="🔄 Проверить обновления (GitHub + STORM GAMES WORLD)" Style="{StaticResource AccentButtonStyle}" Height="36" Padding="14,0" Click="CheckUpdatesButton_Click" CornerRadius="6"/>
                                    <ProgressRing x:Name="UpdateProgressRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Button x:Name="OpenGitHubButton" Content="🌐 GitHub" Height="36" Padding="12,0" Click="OpenGitHubButton_Click" CornerRadius="6"/>
                                    <Button x:Name="OpenStormWorldButton" Content="🚀 STORM GAMES WORLD" Height="36" Padding="12,0" Click="OpenStormWorldButton_Click" CornerRadius="6"/>
                                    <Button x:Name="OpenLogsButton" Content="📂 Папка с логами" Height="36" Padding="12,0" Click="OpenLogsFolder_Click" CornerRadius="6"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- ========================================== -->
            <!-- 2. ВКЛАДКА: НАСТРОЙКИ NINTENDO SWITCH       -->
            <!-- ========================================== -->
            <StackPanel x:Name="SwitchSettingsPanel" Visibility="Collapsed" Spacing="24">
                <!-- БЛОК 1: Криптографические ключи Switch -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="SwitchKeysHeaderTxt" Text="Криптографические ключи Nintendo Switch" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid AllowDrop="True" DragOver="KeysFile_DragOver" Drop="KeysFile_Drop" Padding="4" CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock x:Name="SwitchKeysTitleTxt" Text="Файл криптографических ключей (prod.keys / keys.txt)" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SwitchKeysDescTxt" Text="Загружать ключи для расшифровки. Можно перетащить файл прямо сюда" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind KeysSelectedVisibility, Mode=OneTime}">
                                        <FontIcon Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="14"/>
                                        <TextBlock x:Name="SwitchKeysLoadedTxt" Text="Файл выбран" Foreground="LimeGreen" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="Версия ключей прошивки (6 ячеек)">
                                        <TextBox x:Name="VerBox1" Width="32" Height="32" CornerRadius="6" MaxLength="1" FontSize="14" FontWeight="Bold" Padding="0,3,0,0" TextAlignment="Center" KeyDown="VerBox_KeyDown" TextChanged="VerBox_TextChanged"/>
                                        <TextBox x:Name="VerBox2" Width="32" Height="32" CornerRadius="6" MaxLength="1" FontSize="14" FontWeight="Bold" Padding="0,3,0,0" TextAlignment="Center" KeyDown="VerBox_KeyDown" TextChanged="VerBox_TextChanged"/>
                                        <TextBlock Text="." FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="1,0,1,0"/>
                                        <TextBox x:Name="VerBox4" Width="32" Height="32" CornerRadius="6" MaxLength="1" FontSize="14" FontWeight="Bold" Padding="0,3,0,0" TextAlignment="Center" KeyDown="VerBox_KeyDown" TextChanged="VerBox_TextChanged"/>
                                        <TextBlock Text="." FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="1,0,1,0"/>
                                        <TextBox x:Name="VerBox6" Width="32" Height="32" CornerRadius="6" MaxLength="1" FontSize="14" FontWeight="Bold" Padding="0,3,0,0" TextAlignment="Center" KeyDown="VerBox_KeyDown" TextChanged="VerBox_TextChanged"/>
                                    </StackPanel>
                                    <Button x:Name="SelectKeysButton" Content="📂 Выбрать файл" Click="SelectKeysButton_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Онлайн-загрузка ключей как в STORM SWITCH -->
                            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="🌐 Онлайн-загрузка ключей Nintendo Switch (STORM SWITCH TOOLS)" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="OnlineKeysStatusTxt" Text="Автоматическое скачивание и установка свежих prod.keys и title.keys из облачного репозитория STORM SWITCH" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ComboBox x:Name="OnlineKeysVersionCombo" Width="190" SelectedIndex="0" CornerRadius="6" ToolTipService.ToolTip="Выберите версию ключей прошивки HOS">
                                        <ComboBoxItem Content="23.0.0 (Рекомендуется)" Tag="23.0.0"/>
                                        <ComboBoxItem Content="22.5.0" Tag="22.5.0"/>
                                        <ComboBoxItem Content="22.1.0" Tag="22.1.0"/>
                                        <ComboBoxItem Content="22.0.0" Tag="22.0.0"/>
                                        <ComboBoxItem Content="21.2.0" Tag="21.2.0"/>
                                        <ComboBoxItem Content="21.1.0" Tag="21.1.0"/>
                                        <ComboBoxItem Content="21.0.1" Tag="21.0.1"/>
                                        <ComboBoxItem Content="21.0.0" Tag="21.0.0"/>
                                        <ComboBoxItem Content="20.5.0" Tag="20.5.0"/>
                                        <ComboBoxItem Content="20.1.0" Tag="20.1.0"/>
                                        <ComboBoxItem Content="20.0.1" Tag="20.0.1"/>
                                        <ComboBoxItem Content="20.0.0" Tag="20.0.0"/>
                                        <ComboBoxItem Content="19.0.1" Tag="19.0.1"/>
                                    </ComboBox>
                                    <Button x:Name="DownloadOnlineKeysBtn" Content="⬇️ Скачать ключи" Click="DownloadOnlineKeysButton_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК 4: Алгоритмы сборки и патчинга Switch -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="SwitchAlgoHeaderTxt" Text="Алгоритмы сборки и очистки Switch" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">

                            <!-- KeyGen downgrade -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="KeyGenTitleTxt" Text="Понижение версии ключей (KeyGen)" FontWeight="Medium"/>
                                    <TextBlock x:Name="KeyGenDescTxt" Text="Маскирует требования к прошивке (0-30), позволяя запускать новые игры на старых FW" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox HorizontalAlignment="Right" Width="220" Value="{x:Bind Settings.KeyGeneration, Mode=TwoWay}" Minimum="0" Maximum="30" SpinButtonPlacementMode="Inline" ValueChanged="Setting_ValueChanged" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Multi-Content / HardPatch Build Strategy -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock x:Name="BuildStrategyTitleTxt" Text="Стратегия сборки обновлений и мульти-контента (HardPatch)" FontWeight="Medium"/>
                                    <TextBlock x:Name="BuildStrategyDescTxt" Text="HardPatch физически распаковывает дельту и запекает чистый RomFS в единый Program NCA для гарантированной работы на любых эмуляторах (включая старые версии) и консолях" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="BuildStrategyCombo" HorizontalAlignment="Right" Width="260" SelectionChanged="BuildStrategyCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Умный режим (Авто)" Tag="0" ToolTipService.ToolTip="Умная пересборка HardPatch с авто-откатом на Multi-Content"/>
                                    <ComboBoxItem Content="Прямой Multi-Content (Сшивание 1G+1U)" Tag="2" ToolTipService.ToolTip="Быстрое сшивание базового NCA и обновления без пересборки RomFS"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- RSV Cap Downgrade -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="RsvTitleTxt" Text="Понижение системных требований (RSV Cap Downgrade)" FontWeight="Medium"/>
                                    <TextBlock x:Name="RsvDescTxt" Text="Ограничивает проверку версии системного ПО консоли в метаданных CNMT" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="RsvCapCombo" HorizontalAlignment="Right" Width="220" SelectionChanged="RsvCapCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="FW 23.0 (1509949440)" Tag="1509949440"/>
                                    <ComboBoxItem Content="FW 22.0 (1442840576)" Tag="1442840576"/>
                                    <ComboBoxItem Content="FW 21.0 (1375731712)" Tag="1375731712"/>
                                    <ComboBoxItem Content="FW 20.0 (1308622848)" Tag="1308622848"/>
                                    <ComboBoxItem Content="FW 19.0 (1241513984)" Tag="1241513984"/>
                                    <ComboBoxItem Content="FW 18.0 (268435656)" Tag="268435656"/>
                                    <ComboBoxItem Content="FW 17.0 (251658240)" Tag="251658240"/>
                                    <ComboBoxItem Content="FW 16.0 (234880824)" Tag="234880824"/>
                                    <ComboBoxItem Content="FW 15.0 (218103408)" Tag="218103408"/>
                                    <ComboBoxItem Content="FW 10.0 (134217728)" Tag="134217728"/>
                                    <ComboBoxItem Content="FW 1.0 (65796 - Отключить)" Tag="65796"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Remove Titlerights -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="TitlerightsTitleTxt" Text="Удалить Titlerights (Ticketless NSP)" FontWeight="Medium"/>
                                    <TextBlock x:Name="TitlerightsDescTxt" Text="Конвертирует ticket-зависимые NSP в стандартный крипто-формат без тикетов (--C_clean_ND)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="RemoveTitlerightsToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.RemoveTitlerights, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Игры установятся на любом CFW без привязки к тикетам. Работает через NSC_Builder (--C_clean_ND)."/>
                            </Grid>

                            <!-- Split FAT32 -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="Fat32TitleTxt" Text="Разделять файлы для FAT32 (> 4 GB)" FontWeight="Medium"/>
                                    <TextBlock x:Name="Fat32DescTxt" Text="Автоматически разбивает готовые файлы > 4 ГБ на чанки (.xc0/.xc1 или .00/.01) для FAT32 SD-карт" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="SplitFat32Toggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.SplitFat32, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Разбивает выходные файлы >4GB на части для совместимости со старыми FAT32 флешками."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Удаление мусорных Delta NCA (Delta Cleaner) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="DeltaTitleTxt" Text="Удалять Delta NCA из обновлений" FontWeight="Medium"/>
                                    <TextBlock x:Name="DeltaDescTxt" Text="Удаляет избыточные дельта-патчи из Update-файлов для экономии до 30% места (-ND true)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="RemoveDeltaNcaToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.RemoveDeltaNca, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Удаляет мусорные Delta NCA из файлов обновлений, кардинально снижая вес без потери данных."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Оптимизация ассетов модов (Oxipng и очистка мусора) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ModOptimizerTitleTxt" Text="Оптимизация ассетов модов (Oxipng и очистка мусора)" FontWeight="Medium"/>
                                    <TextBlock x:Name="ModOptimizerDescTxt" Text="Удаляет временные и системные файлы (.bak, .tmp, Thumbs.db, .DS_Store) и сжимает PNG без потерь через Oxipng (экономия 20–40% веса)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OptimizeModAssetsToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.OptimizeModAssets, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Автоматическая очистка мусора из модов и сжатие текстур PNG без потери качества."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Block NSZ Compression -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="SolidCompressTitleTxt" Text="Сжатие через внешний движок nsz.exe (--block, 1 МБ)" FontWeight="Medium"/>
                                    <TextBlock x:Name="SolidCompressDescTxt" Text="Использовать официальный компрессор nsz.exe с независимыми блоками по 1 МБ (NCZBLOCK) вместо встроенного движка" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="SolidCompressToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.SolidCompression, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Оба компрессора (встроенный и внешний) всегда сжимают методом Block с блоками 1 МБ для прямого запуска в эмуляторах без распаковки на диск."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Auto-Inject 60 FPS Patches -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="Patches60FpsTitleTxt" Text="Авто-инъекция патчей 60 FPS и твиков графики" FontWeight="Medium"/>
                                    <TextBlock x:Name="Patches60FpsDescTxt" Text="Автоматически внедряет актуальные IPS патчи 60 кадров/сек и исправления графики при пересборке" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="Patches60FpsToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.AutoInject60FpsPatches, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Вшивает проверенные сообществом твики графики и 60 FPS прямо в модуль ExeFS main."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- DLC Completeness Check -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="DlcCheckerTitleTxt" Text="Инспектор полноты дополнений (DLC Completeness)" FontWeight="Medium"/>
                                    <TextBlock x:Name="DlcCheckerDescTxt" Text="Сверяет состав дополнений с глобальной базой TitleDB и сообщает о недостающих DLC в логе задачи" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="DlcCheckerToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.EnableDlcCompletenessCheck, Mode=TwoWay}" Toggled="Toggle_Changed" 
                                              ToolTipService.ToolTip="Анализирует собранные дополнения и выводит список недостающих DLC из базы TitleDB."/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Language Trimming -->
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="LangTrimTitleTxt" Text="Удалять неиспользуемые языки из RomFS" FontWeight="Medium"/>
                                        <TextBlock x:Name="LangTrimDescTxt" Text="Работает при конвертации NSP/NSZ → XCI/XCZ и при HardPatch (пересборка Base+Update)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TrimXciToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.TrimXci, Mode=TwoWay}" Toggled="Toggle_Changed" ToolTipService.ToolTip="Удаляет неиспользуемые языковые данные из RomFS при конвертации или пересборке. Уменьшает размер файла."/>
                                </Grid>
                                
                                <!-- Выбор языков -->
                                <Border x:Name="LanguageSelectionPanel" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="14"
                                        Visibility="{x:Bind TrimXciToggle.IsOn, Mode=OneWay}">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="LangTrimSubTxt" Text="Выберите языки, которые нужно ОСТАВИТЬ при вырезании:" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ItemsControl x:Name="LanguageItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="180" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Автоматическая «Умная» папка (Switch Watch Folder) -->
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SwitchWatchTitleTxt" Text="«Умная» папка Nintendo Switch" FontWeight="Medium"/>
                                        <TextBlock x:Name="SwitchWatchDescTxt" Text="Автоматически обнаруживает файлы Switch (.nsp, .nsz, .xci, .xcz, архивы .zip, .rar, .7z) и отправляет в задачи" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WatchFolderSwitchToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.EnableWatchFolderSwitch, Mode=TwoWay}" Toggled="WatchFolderSwitchToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Visibility="{x:Bind WatchFolderSwitchToggle.IsOn, Mode=OneWay}" Spacing="12" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WatchFolderBoxSwitch" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Папка не выбрана (можно перетащить)" 
                                                 Text="{x:Bind Settings.WatchFolderSwitch, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                                 AllowDrop="True" DragOver="WatchFolderBoxSwitch_DragOver" Drop="WatchFolderBoxSwitch_Drop"/>
                                        <Button x:Name="SelectWatchFolderSwitchButton" Grid.Column="1" Content="Выбрать папку..." Click="SelectWatchFolderSwitch_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="SwitchWatchTaskAndFmtTxt" Text="Выполняемая задача и формат:" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WatchFolderSwitchSummaryBadge" Text="⚡ Switch авто-обработка: Сжатие в NSZ" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold"/>
                                        </StackPanel>

                                        <ComboBox x:Name="WatchFolderActionComboSwitch" Grid.Column="1" Width="160" Margin="0,0,8,0" SelectionChanged="WatchFolderActionComboSwitch_SelectionChanged" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Сжатие" Tag="0"/>
                                            <ComboBoxItem Content="Распаковка" Tag="1"/>
                                            <ComboBoxItem Content="Упаковка" Tag="2"/>
                                            <ComboBoxItem Content="Конвертация" Tag="3"/>
                                            <ComboBoxItem Content="Мульти-контент" Tag="4"/>
                                            <ComboBoxItem Content="Проверка" Tag="5"/>
                                        </ComboBox>

                                        <ComboBox x:Name="WatchFolderFormatComboSwitch" Grid.Column="2" Width="90" Margin="0,0,12,0" SelectionChanged="WatchFolderFormatComboSwitch_SelectionChanged" VerticalAlignment="Center">
                                            <ComboBoxItem Content="NSP" Tag="0"/>
                                            <ComboBoxItem Content="NSZ" Tag="1"/>
                                            <ComboBoxItem Content="XCI" Tag="2"/>
                                            <ComboBoxItem Content="XCZ" Tag="3"/>
                                        </ComboBox>

                                        <Button x:Name="ToggleWatchFolderSwitchBtn" Grid.Column="3" Content="▶ Запустить отслеживание" Click="ToggleWatchFolderSwitchBtn_Click" 
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6" Padding="12,6"/>
                                    </Grid>
                                    <TextBlock x:Name="WatchFolderSwitchStatusTxt" Text="○ Отслеживание остановлено" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Выходная папка по умолчанию Switch -->
                            <Grid AllowDrop="True" DragOver="OutputFolderBox_DragOver" Drop="OutputFolderBox_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="SwitchOutFolderTitleTxt" Text="Выходная папка Switch по умолчанию" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SwitchOutFolderDescTxt" Text="Папка для сохранения обработанных файлов Switch (.nsp / .nsz / .xci / .xcz). Можно перетащить папку сюда" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" AllowDrop="True" DragOver="OutputFolderBox_DragOver" Drop="OutputFolderBox_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderBox" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Не указана (сохранять в папку с исходным файлом)" 
                                             Text="{x:Bind Settings.OutputFolder, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="OutputFolderBox_DragOver" Drop="OutputFolderBox_Drop"/>
                                    <Button x:Name="SelectOutputFolderButton" Grid.Column="1" Content="Обзор..." Click="SelectOutputFolder_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearOutputFolderButton" Grid.Column="2" Content="✕ Очистить" Click="ClearOutputFolder_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Очистить выходную папку Switch"/>
                                </Grid>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Каталог для архивов SDMC -->
                            <Grid AllowDrop="True" DragOver="SdmcArchiveFolderBox_DragOver" Drop="SdmcArchiveFolderBox_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="SdmcArchiveFolderTitleTxt" Text="Каталог для архивов SDMC" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SdmcArchiveFolderDescTxt" Text="Папка для упаковки готовых SDMC-пакетов в автономные ZIP-архивы (.zip) для реальной консоли Switch. Если путь не указан — архивы не создаются, а выходная папка с играми остается идеально чистой" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" AllowDrop="True" DragOver="SdmcArchiveFolderBox_DragOver" Drop="SdmcArchiveFolderBox_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SdmcArchiveFolderBox" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Не указан (автономные ZIP-архивы не создаются)" 
                                             Text="{x:Bind Settings.SdmcArchiveFolder, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="SdmcArchiveFolderBox_DragOver" Drop="SdmcArchiveFolderBox_Drop"/>
                                    <Button x:Name="SelectSdmcArchiveFolderButton" Grid.Column="1" Content="Обзор..." Click="SelectSdmcArchiveFolder_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearSdmcArchiveFolderButton" Grid.Column="2" Content="✕ Очистить" Click="ClearSdmcArchiveFolder_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Очистить каталог для архивов SDMC"/>
                                </Grid>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 2. ВКЛАДКА: НАСТРОЙКИ NINTENDO SWITCH 2     -->
            <!-- ========================================== -->
            <StackPanel x:Name="Switch2SettingsPanel" Visibility="Collapsed" Spacing="24">
                <!-- БЛОК 1: Криптографические ключи Switch 2 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Криптографические ключи Nintendo Switch 2 (Ounce / NVN2)" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- prod.keys row -->
                            <Grid AllowDrop="True" DragOver="KeysFileSwitch2_DragOver" Drop="KeysFileSwitch2_Drop" Padding="4" CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Файл криптографических ключей Switch 2 (prod.keys / ounce.keys)" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Мастер-ключи Horizon OS и спецификация Ounce для расшифровки и сборки дампов Switch 2. Поддерживается перетаскивание (Drag и Drop)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="AutoDetectSwitch2KeysBtn" Content="🔍 Авто-поиск" Click="AutoDetectSwitch2Keys_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Автоматический поиск ключей Switch 2 в системных папках"/>
                                    <Button x:Name="SelectSwitch2KeysBtn" Content="📁 Выбрать файл" Click="SelectSwitch2Keys_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6"/>
                                    <Button x:Name="ClearSwitch2KeysBtn" Content="✕ Сбросить" Click="ClearSwitch2Keys_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Сбросить выбранный путь"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="Switch2KeysStatusBadge" Text="⚠️ Ключи не загружены" FontWeight="Bold" FontSize="13" Foreground="#E74C3C"/>
                                        <TextBlock x:Name="Switch2KeysVersionBadge" Text="• Версия прошивки: Ожидание ключей" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Switch2KeysCountTxt" Text="Загружено ключей: 0 шт." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="Switch2KeysPathTxt" Text="Активный файл: Не указан (нажмите «Авто-поиск» или «Выбрать файл»)" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- title.keys row -->
                            <Grid Padding="4" CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Файл ключей тайтлов Switch 2 (title.keys)" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="Switch2TitleKeysStatusTxt" Text="Опционально: загружается автоматически, если файл лежит рядом с prod.keys" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="SelectSwitch2TitleKeysBtn" Content="📁 Выбрать файл" Click="SelectSwitch2TitleKeys_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                    <Button x:Name="ClearSwitch2TitleKeysBtn" Content="✕ Сбросить" Click="ClearSwitch2TitleKeys_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК 2: Формат контейнера и параметры сжатия Nintendo Switch 2 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Формат контейнера и параметры сжатия Nintendo Switch 2" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Формат контейнера по умолчанию -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Формат выходного контейнера Switch 2 по умолчанию" FontWeight="Medium"/>
                                    <TextBlock Text="Целевой контейнер сборки: NSZ (блочный NCZBLOCK, рекомендуется), чистый NSP, картридж XCI или XCZ" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="Switch2DefaultFormatCombo" HorizontalAlignment="Right" Width="280" SelectionChanged="Switch2DefaultFormatCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="NSZ (Блочный NCZBLOCK, рекомендуется)" Tag="NSZ"/>
                                    <ComboBoxItem Content="NUP — Монолитный контейнер Switch 2 (NUP v1.0, Zstandard + Дедупликация)" Tag="NUP"/>
                                    <ComboBoxItem Content="NSP (Чистый контейнер PFS0)" Tag="NSP"/>
                                    <ComboBoxItem Content="XCI (Картридж Switch 2)" Tag="XCI"/>
                                    <ComboBoxItem Content="XCZ (Сжатый картридж)" Tag="XCZ"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Блочное сжатие Zstandard -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Блочное сжатие Zstandard для Switch 2 (NSZ / XCZ)" FontWeight="Medium"/>
                                    <TextBlock Text="Сжимать результирующие дампы Switch 2 по спецификации NCZBLOCK v2 с произвольным доступом блоков" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2BlockCompression, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Уровень сжатия Zstandard (1-22) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Уровень сжатия Zstandard (1–22)" FontWeight="Medium"/>
                                    <TextBlock Text="Степень сжатия Zstd (по умолчанию: 18). Уровни 19–22 обеспечивают сверхплотную упаковку при повышенной нагрузке" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                                    <Slider x:Name="Switch2CompressionSlider" Width="200" Minimum="1" Maximum="22" StepFrequency="1"
                                            Value="18" ValueChanged="Switch2CompressionSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Switch2CompressionValTxt" Text="18" Width="36" TextAlignment="Center" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Размер блока NCZBLOCK -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Размер блока NCZBLOCK" FontWeight="Medium"/>
                                    <TextBlock Text="Размер блока сжатия при упаковке NCZ. 1 МБ обеспечивает идеальный баланс скорости распаковки и сжатия" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="Switch2BlockSizeCombo" HorizontalAlignment="Right" Width="220" SelectedIndex="{x:Bind Settings.Switch2BlockSizeIndex, Mode=TwoWay}" SelectionChanged="Switch2BlockSizeCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="256 КБ"/>
                                    <ComboBoxItem Content="512 КБ"/>
                                    <ComboBoxItem Content="1 МБ (Рекомендуется)"/>
                                    <ComboBoxItem Content="2 МБ"/>
                                    <ComboBoxItem Content="4 МБ"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Потоки процессора при сборке и сжатии -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Потоки процессора при сборке и сжатии" FontWeight="Medium"/>
                                    <TextBlock Text="Количество параллельных потоков ЦП для многопоточного сжатия Zstandard без зависаний системы" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="Switch2ThreadsCombo" HorizontalAlignment="Right" Width="220" SelectedIndex="{x:Bind Settings.Switch2ThreadsIndex, Mode=TwoWay}" SelectionChanged="Switch2ThreadsCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Авто (Оптимально)"/>
                                    <ComboBoxItem Content="2 потока (Пониженная нагрузка)"/>
                                    <ComboBoxItem Content="4 потока (Рекомендуется)"/>
                                    <ComboBoxItem Content="8 потоков"/>
                                    <ComboBoxItem Content="Максимум"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК 3: Умная сшивка, оптимизация и модификации (SmartShrink и Hard-Patch) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Умная сшивка, оптимизация и модификации (SmartShrink и Hard-Patch)" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- SmartShrink для Switch 2 -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="SmartShrink для Switch 2 (удаление 0xFF/0x00 паддингов и выравнивание секторов)" FontWeight="Medium"/>
                                    <TextBlock Text="Автоматическое удаление пустых областей 0xFF/0x00 и нормализация смещений секторов PFS0 для экономии места" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2SmartShrink, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Авто-сшивка Мульти-контента -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Авто-сшивка Мульти-контента (База + Обновления + DLC в единый монолитный файл)" FontWeight="Medium"/>
                                    <TextBlock Text="Автоматически объединять базовую игру, обновления и все DLC в единый монолитный файл формата 1G+1U+ND" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2AutoStitchMultiContent, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Режим прямого вшивания обновлений в RomFS (Hard-Patch) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Режим прямого вшивания обновлений в RomFS (Hard-Patch + 4 КБ Patch CNMT)" FontWeight="Medium"/>
                                    <TextBlock Text="Распаковывает дельту обновления и запекает чистый RomFS в единый монолитный контейнер для гарантированной совместимости" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2HardPatchRomFs, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Распаковка и перепаковка потоковых архивов (.zs / Zstandard RomFS) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Распаковка и перепаковка потоковых архивов (.zs / Zstandard RomFS)" FontWeight="Medium"/>
                                    <TextBlock Text="Автоматическая распаковка и обратная перепаковка сжатых архивов .zs внутри RomFS при сшивке и внедрении локализаций" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2ZstdRomFsHandling, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Авто-вшивание модов, русификаторов и читов -->
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Авто-вшивание модов, русификаторов и читов (base/romfs, exefs)" FontWeight="Medium"/>
                                        <TextBlock Text="Автоматическая интеграция модификаций, переводов и графических патчей из указанной папки при сборке контейнера" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2AutoInjectMods, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid AllowDrop="True" DragOver="Switch2ModsFolder_DragOver" Drop="Switch2ModsFolder_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="Switch2ModsFolderBox" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Папка модов и русификаторов Switch 2 (не указана)"
                                             Text="{x:Bind Settings.Switch2ModsFolder, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="Switch2ModsFolder_DragOver" Drop="Switch2ModsFolder_Drop"/>
                                    <Button x:Name="SelectSwitch2ModsFolderBtn" Grid.Column="1" Content="Обзор..." Click="SelectSwitch2ModsFolder_Click" VerticalAlignment="Center" Margin="0,0,8,0" CornerRadius="6"/>
                                    <Button x:Name="ClearSwitch2ModsFolderBtn" Grid.Column="2" Content="✕ Очистить" Click="ClearSwitch2ModsFolder_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                </Grid>
                            </StackPanel>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Авто-разблокировка дополнений (DLC Unlocker) -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Авто-разблокировка дополнений (Switch 2 DLC Unlocker)" FontWeight="Medium"/>
                                    <TextBlock Text="Генерация универсальных билетов и снятие консольных ограничений для мгновенного доступа ко всем установленным DLC" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2DlcUnlocker, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Патчер эмуляторов Switch 2 и поддержка NUP / Plaintext NSP (NSP-Box Direct Boot) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Патчер эмуляторов Switch 2 и поддержка NUP / Plaintext NSP (NSP-Box Direct Boot)" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Обратимая модификация исполняемого файла эмулятора" FontWeight="Medium" TextWrapping="Wrap"/>
                                    <TextBlock Text="Обратимая модификация исполняемого файла эмулятора (Eden sx2a, PokeDinner, Eglantine, Selevet) для прямого запуска упакованных .nup и Plaintext .nsp без внешнего main.npdm (с авто-резервной копией .bak)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="PatchEmulatorExeBtn" Content="⚡ Пропатчить .exe эмулятора" Click="PatchEmulatorExe_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Выбрать .exe эмулятора для применения обратимого патча Direct Boot"/>
                                    <Button x:Name="RestoreEmulatorExeBtn" Content="↩ Восстановить оригинал (.bak)" Click="RestoreEmulatorExe_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Восстановить исходный исполняемый файл эмулятора из резервной копии .bak"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status panel -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EmulatorPatcherStatusTxt" Text="Статус: Патчер готов к работе. Выберите исполняемый файл эмулятора Switch 2 (.exe)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК 4: Безопасность, совместимость и верификация -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Безопасность, совместимость и верификация Switch 2" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Очистка персональных билетов и подписей аккаунта -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Очистка персональных билетов и подписей аккаунта (Strip Personalized Tickets)" FontWeight="Medium"/>
                                    <TextBlock Text="Удаление персональных сертификатов консоли, аккаунтных подписей и привязок билетов (чистый Ticketless контейнер)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2StripPersonalizedTickets, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Патч минимальной требуемой версии прошивки -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Патч минимальной требуемой версии прошивки (MasterKey / Min OS Version)" FontWeight="Medium"/>
                                    <TextBlock Text="Коррекция полей RequiredSystemVersion в метаданных CNMT для предотвращения ложных ошибок устаревшей прошивки" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2PatchMinRequiredOs, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Автоматическая проверка целостности после сборки -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Автоматическая проверка целостности (SHA-256 / NSO0 / NPDM / PFS0) после сборки" FontWeight="Medium"/>
                                    <TextBlock Text="Комплексная верификация хэшей всех блоков NCA, заголовков NPDM и структуры PFS0 сразу по завершении компиляции" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2VerifyIntegrityAfterBuild, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Удалять исходные архивы и временные дампы после сборки -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Удалять исходные архивы (.zip / .7z) и временные дампы после успешной сборки" FontWeight="Medium"/>
                                    <TextBlock Text="Автоматическое освобождение дискового пространства: удаление входных архивов и дампов строго при 100% успехе" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Settings.Switch2DeleteSourceOnSuccess, Mode=TwoWay}" Toggled="Toggle_Changed" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- БЛОК 5: Папка сохранения и библиотека Nintendo Switch 2 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED25;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="Папка сохранения и библиотека Nintendo Switch 2" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Выходная папка по умолчанию -->
                            <Grid AllowDrop="True" DragOver="OutputFolderBoxSwitch2_DragOver" Drop="OutputFolderBoxSwitch2_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="Switch2OutFolderTitleTxt" Text="Выходная папка Nintendo Switch 2 по умолчанию" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Switch2OutFolderDescTxt" Text="Папка для сохранения обработанных файлов Nintendo Switch 2 (.nsp / .nsz / .xci / .xcz). По умолчанию: Q:\CONSOLES\Nintendo Switch 2\GAMES" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" AllowDrop="True" DragOver="OutputFolderBoxSwitch2_DragOver" Drop="OutputFolderBoxSwitch2_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderBoxSwitch2" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Не указана (по умолчанию Q:\CONSOLES\Nintendo Switch 2\GAMES)" 
                                             Text="{x:Bind Settings.OutputFolderSwitch2, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="OutputFolderBoxSwitch2_DragOver" Drop="OutputFolderBoxSwitch2_Drop"/>
                                    <Button x:Name="SelectOutputFolderSwitch2Button" Grid.Column="1" Content="Обзор..." Click="SelectOutputFolderSwitch2_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearOutputFolderSwitch2Button" Grid.Column="2" Content="✕ Очистить" Click="ClearOutputFolderSwitch2_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Очистить выходную папку Switch 2"/>
                                </Grid>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Папка загрузок и распаковки дампов Switch 2 -->
                            <Grid AllowDrop="True" DragOver="DownloadsFolderBoxSwitch2_DragOver" Drop="DownloadsFolderBoxSwitch2_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="2">
                                    <TextBlock Text="Папка загрузок и распаковки дампов Switch 2" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="Каталог распакованных дампов Switch 2 (exefs/romfs) или архивов. По умолчанию: Q:\CONSOLES\Nintendo Switch 2\DOWNLOADS" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" AllowDrop="True" DragOver="DownloadsFolderBoxSwitch2_DragOver" Drop="DownloadsFolderBoxSwitch2_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DownloadsFolderBoxSwitch2" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Не указана (по умолчанию Q:\CONSOLES\Nintendo Switch 2\DOWNLOADS)" 
                                             Text="{x:Bind Settings.Switch2DownloadsFolder, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="DownloadsFolderBoxSwitch2_DragOver" Drop="DownloadsFolderBoxSwitch2_Drop"/>
                                    <Button x:Name="SelectDownloadsFolderSwitch2Button" Grid.Column="1" Content="Обзор..." Click="SelectDownloadsFolderSwitch2_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearDownloadsFolderSwitch2Button" Grid.Column="2" Content="✕ Очистить" Click="ClearDownloadsFolderSwitch2_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0" ToolTipService.ToolTip="Очистить папку загрузок"/>
                                    <Button x:Name="ScanAndEnqueueSwitch2DownloadsBtn" Grid.Column="3" Content="🔍 Сканировать и добавить в задачник" Click="ScanAndEnqueueSwitch2Downloads_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Сканировать папку на наличие дампов Switch 2 и отправить их в обработку"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. ВКЛАДКА: НАСТРОЙКИ NINTENDO 3DS         -->
            <!-- ========================================== -->
            <StackPanel x:Name="ThreeDsSettingsPanel" Visibility="Collapsed" Spacing="24">
                <!-- БЛОК: Ключи 3DS -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="ThreeDsKeysHeaderTxt" Text="Криптографические ключи Nintendo 3DS" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid AllowDrop="True" DragOver="KeysFile3ds_DragOver" Drop="KeysFile3ds_Drop" Padding="4" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                <TextBlock x:Name="ThreeDsKeysTitleTxt" Text="Файл ключей 3DS (aes_keys.txt / boot9.bin / encTitleKeys.bin)" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ThreeDsKeysDescTxt" Text="Используется для дешифровки NCCH, CIA и RomFS при сборке и конвертации. Можно перетащить файл сюда" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind Keys3dsSelectedVisibility, Mode=OneTime}">
                                    <FontIcon Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="14"/>
                                    <TextBlock x:Name="ThreeDsKeysLoadedTxt" Text="Ключи подключены" Foreground="LimeGreen" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <Button x:Name="SelectKeys3dsButton" Content="📂 Выбрать файл" Click="SelectKeys3dsButton_Click" VerticalAlignment="Center" CornerRadius="6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- БЛОК: Параметры сборки 3DS -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock x:Name="ThreeDsAlgoHeaderTxt" Text="Алгоритмы сборки и форматы Nintendo 3DS" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Выходной формат 3DS по умолчанию -->
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="ThreeDsFormatTitleTxt" Text="Выходной формат 3DS по умолчанию" FontWeight="Medium"/>
                                    <TextBlock x:Name="ThreeDsFormatDescTxt" Text="Формат по умолчанию для конвертации и сборки (.3ds / .cci для эмуляторов Citra/Lime3DS, .cia для установки)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="Format3dsCombo" HorizontalAlignment="Right" Width="300" SelectionChanged="Format3dsCombo_SelectionChanged" VerticalAlignment="Center">
                                    <ComboBoxItem Content="3DS (CCI - для эмуляторов)" Tag="3DS"/>
                                    <ComboBoxItem Content="CIA (Установочный пакет)" Tag="CIA"/>
                                    <ComboBoxItem Content="CXI (Исполняемый NCCH)" Tag="CXI"/>
                                </ComboBox>
                            </Grid>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Автоматическая «Умная» папка (3DS Watch Folder) -->
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ThreeDsWatchTitleTxt" Text="«Умная» папка Nintendo 3DS" FontWeight="Medium"/>
                                        <TextBlock x:Name="ThreeDsWatchDescTxt" Text="Автоматически обнаруживает файлы 3DS (.3ds, .cci, .cia, .cxi, архивы .zip, .rar, .7z) и отправляет в задачи" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WatchFolder3dsToggle" HorizontalAlignment="Right" IsOn="{x:Bind Settings.EnableWatchFolder3ds, Mode=TwoWay}" Toggled="WatchFolder3dsToggle_Toggled" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Visibility="{x:Bind WatchFolder3dsToggle.IsOn, Mode=OneWay}" Spacing="12" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WatchFolderBox3ds" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Папка не выбрана (можно перетащить)" 
                                                 Text="{x:Bind Settings.WatchFolder3ds, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                                 AllowDrop="True" DragOver="WatchFolderBox3ds_DragOver" Drop="WatchFolderBox3ds_Drop"/>
                                        <Button x:Name="SelectWatchFolder3dsButton" Grid.Column="1" Content="Выбрать папку..." Click="SelectWatchFolder3ds_Click" VerticalAlignment="Center" CornerRadius="6"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="ThreeDsWatchTaskAndFmtTxt" Text="Выполняемая задача и формат:" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WatchFolder3dsSummaryBadge" Text="⚡ 3DS авто-обработка: Мульти-контент в 3DS" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold"/>
                                        </StackPanel>

                                        <ComboBox x:Name="WatchFolderActionCombo3ds" Grid.Column="1" Width="160" Margin="0,0,8,0" SelectionChanged="WatchFolderActionCombo3ds_SelectionChanged" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Конвертация" Tag="0"/>
                                            <ComboBoxItem Content="Распаковка" Tag="1"/>
                                            <ComboBoxItem Content="Упаковка" Tag="2"/>
                                            <ComboBoxItem Content="Мульти-контент" Tag="3"/>
                                            <ComboBoxItem Content="Проверка" Tag="4"/>
                                        </ComboBox>

                                        <ComboBox x:Name="WatchFolderFormatCombo3ds" Grid.Column="2" Width="90" Margin="0,0,12,0" SelectionChanged="WatchFolderFormatCombo3ds_SelectionChanged" VerticalAlignment="Center">
                                            <ComboBoxItem Content="3DS" Tag="0"/>
                                            <ComboBoxItem Content="CIA" Tag="1"/>
                                            <ComboBoxItem Content="CXI" Tag="2"/>
                                        </ComboBox>

                                        <Button x:Name="ToggleWatchFolder3dsBtn" Grid.Column="3" Content="▶ Запустить отслеживание" Click="ToggleWatchFolder3dsBtn_Click" 
                                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" CornerRadius="6" Padding="12,6"/>
                                    </Grid>
                                    <TextBlock x:Name="WatchFolder3dsStatusTxt" Text="○ Отслеживание остановлено" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <!-- Выходная папка по умолчанию 3DS -->
                            <Grid AllowDrop="True" DragOver="OutputFolderBox3ds_DragOver" Drop="OutputFolderBox3ds_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="ThreeDsOutFolderTitleTxt" Text="Выходная папка 3DS по умолчанию" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThreeDsOutFolderDescTxt" Text="Папка для сохранения обработанных файлов 3DS (.3ds / .cia / .cxi). Можно перетащить папку сюда" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" AllowDrop="True" DragOver="OutputFolderBox3ds_DragOver" Drop="OutputFolderBox3ds_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderBox3ds" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Не указана (сохранять в папку с исходным файлом)" 
                                             Text="{x:Bind Settings.OutputFolder3ds, Mode=TwoWay}" IsReadOnly="True" VerticalAlignment="Center"
                                             AllowDrop="True" DragOver="OutputFolderBox3ds_DragOver" Drop="OutputFolderBox3ds_Drop"/>
                                    <Button x:Name="SelectOutputFolder3dsButton" Grid.Column="1" Content="Обзор..." Click="SelectOutputFolder3ds_Click" VerticalAlignment="Center" CornerRadius="6" Margin="0,0,8,0"/>
                                    <Button x:Name="ClearOutputFolder3dsButton" Grid.Column="2" Content="✕ Очистить" Click="ClearOutputFolder3ds_Click" VerticalAlignment="Center" CornerRadius="6" ToolTipService.ToolTip="Очистить выходную папку 3DS"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

