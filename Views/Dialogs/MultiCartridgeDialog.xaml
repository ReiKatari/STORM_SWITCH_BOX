<ContentDialog
    x:Class="StormSwitchBox.Views.Dialogs.MultiCartridgeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:StormSwitchBox.Services"
    mc:Ignorable="d"
    Title="??? ??????????? ??????-?????????? XCI / XCZ (Multi-Game Cartridge Builder)"
    CloseButtonText="???????"
    CornerRadius="8"
    MinWidth="860"
    MaxWidth="1020">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ??????? ?????? ???????? -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="? ???????? ???? / ????? / DLC (.NSP/.NSZ/.XCI/.XCZ)" Click="AddFiles_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="4"/>
            <Button Grid.Column="1" Content="??? ???????? ??????" Click="ClearFiles_Click" CornerRadius="4"/>
            <TextBlock x:Name="SummaryText" Grid.Column="3" Text="??????: 0 | ????? ??????: 0 ?" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- ?????? ??????????? ??? -->
        <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
            <ListView x:Name="ItemsListView" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:MultiCartridgeItem">
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TitleId}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ContentType}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind FileName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind SizeFormatted}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ????????? ?????? -->
        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CartridgeNameBox" Grid.Row="0" Grid.Column="0" Header="??? ???????? (??????-?????????)" Text="STORM Multi-Game Collection [1G+Multi]" CornerRadius="4"/>
            <ComboBox x:Name="OutputFormatCombo" Grid.Row="0" Grid.Column="1" Header="??????? ??????" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="4">
                <ComboBoxItem Content="XCI (Trimmed Multi-Cart)" Tag="XCI"/>
                <ComboBoxItem Content="XCZ (?????? Multi-Cart)" Tag="XCZ"/>
            </ComboBox>
            <Button x:Name="BuildButton" Grid.Row="0" Grid.Column="2" Content="?? ??????? ??????-????????" Click="BuildCartridge_Click" VerticalAlignment="Bottom" Height="34" Style="{StaticResource AccentButtonStyle}" CornerRadius="4"/>

            <TextBox x:Name="OutputFolderBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="???????? ?????" CornerRadius="4"/>
            <Button Grid.Row="1" Grid.Column="2" Content="?? ?????..." Click="BrowseFolder_Click" VerticalAlignment="Bottom" Height="34" CornerRadius="4"/>
        </Grid>

        <!-- ???????? ?????? -->
        <StackPanel Grid.Row="3" Spacing="6">
            <ProgressBar x:Name="BuildProgressBar" Minimum="0" Maximum="100" Value="0" Height="8"/>
            <TextBlock x:Name="StatusTextBlock" Text="???????? 2 ??? ????? ??? Switch (.NSP, .NSZ, .XCI, .XCZ) ??? ???????? ? ?????? ??????-???????? ??? MIG Switch, ?????????? ? ????????? ????????." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ContentDialog>
