<ContentDialog
    x:Class="StormSwitchBox.Views.Dialogs.ControlEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="?? ?????? ??????????, ?????? ? 3DS ????????"
    PrimaryButtonText="?????????"
    CloseButtonText="??????"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="8"
    MinWidth="680"
    MaxWidth="760">

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <Grid RowSpacing="14" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ??????? ??????: ?????? + Title ID / ?????? -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ?????? ? ????? Drag-and-Drop -->
                <Border Grid.Column="0" Width="136" Height="136" CornerRadius="10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                        Background="#1E293B" AllowDrop="True"
                        DragOver="IconDropArea_DragOver" Drop="IconDropArea_Drop"
                        ToolTipService.ToolTip="?????????? ????? ??????????? (PNG/JPEG) ??? ????????? ?????? ????">
                    <Grid>
                        <Image x:Name="GameIconImage" Stretch="UniformToFill" Width="132" Height="132"/>
                        <Border Background="#99000000" VerticalAlignment="Bottom" Height="24">
                            <TextBlock Text="Live-?????? ??????" FontSize="10" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ???? ? ?????? ?????? ?????? -->
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Title ID:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TitleIdText" Text="0100000000000000" FontFamily="Consolas" FontWeight="Bold"/>
                        <Border x:Name="PlatformBadge" Background="#0284C7" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock x:Name="PlatformBadgeText" Text="SWITCH" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="??????:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="VersionText" Text="1.0.0" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="?? ??????? ?????? (PNG/JPG)" Click="SelectIconButton_Click" CornerRadius="4"/>
                        <Button Content="?? ????????" Click="ResetIconButton_Click" CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ??????: ?????? ?????????? ??????? ?? ?????? -->
            <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="?? ?????????? ?????? ?? ?????? (256x256 Switch / 48x48 3DS SMDH)" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <CheckBox x:Name="BadgeRusCheck" Content="???? [RUS]" Checked="Badge_Changed" Unchecked="Badge_Changed" MinWidth="85"/>
                        <CheckBox x:Name="Badge60FpsCheck" Content="? [60 FPS]" Checked="Badge_Changed" Unchecked="Badge_Changed" MinWidth="95"/>
                        <CheckBox x:Name="BadgeModCheck" Content="??? [MOD]" Checked="Badge_Changed" Unchecked="Badge_Changed" MinWidth="85"/>
                        <CheckBox x:Name="BadgeAllDlcCheck" Content="?? [ALL DLC]" Checked="Badge_Changed" Unchecked="Badge_Changed" MinWidth="95"/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomBadgeBox" Grid.Column="0" PlaceholderText="???? ????? ?????? (????. HD, 2.0, CHEAT)" TextChanged="CustomBadgeBox_TextChanged" CornerRadius="4"/>
                        <ComboBox x:Name="BadgePositionCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="BadgePositionCombo_SelectionChanged" SelectedIndex="0" CornerRadius="4">
                            <ComboBoxItem Content="????? ??????" Tag="BottomRight"/>
                            <ComboBoxItem Content="????? ?????" Tag="BottomLeft"/>
                            <ComboBoxItem Content="?????? ??????" Tag="TopRight"/>
                            <ComboBoxItem Content="?????? ?????" Tag="TopLeft"/>
                            <ComboBoxItem Content="????? ????? (Ribbon)" Tag="BottomBar"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ??????: ????????? ?????-?????? 3DS ??????? -->
            <Border x:Name="AudioBannerSection" Grid.Row="2" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="?? ?????-?????? 3D-??????? Nintendo 3DS (.WAV / .BCWAV -> CBMD)" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AudioWavPathBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="???????????? ???????? ?????? ???? (?? 3 ???. WAV PCM ??? BCWAV)" CornerRadius="4"/>
                        <Button Grid.Column="1" Content="?? ??????? WAV/BCWAV" Click="SelectAudioWav_Click" CornerRadius="4"/>
                        <Button Grid.Column="2" Content="?" Click="ClearAudioWav_Click" CornerRadius="4" ToolTipService.ToolTip="???????? ????????? ????"/>
                    </Grid>
                </StackPanel>
            </Border>

            <MenuFlyoutSeparator Grid.Row="3"/>

            <!-- ???? ????? ???????? -->
            <StackPanel Grid.Row="4" Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="???????? ???? (English / ????????)" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="TitleEnglishBox" PlaceholderText="????????: The Legend of Zelda" CornerRadius="4"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="???????? ???? (???????)" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="TitleRussianBox" PlaceholderText="????????: The Legend of Zelda [RUS]" CornerRadius="4"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="???????? / ???????????" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="PublisherBox" PlaceholderText="????????: Nintendo" CornerRadius="4"/>
                </StackPanel>

                <!-- ?????? ???????? ??????????? (RomFS / ExeFS) -->
                <StackPanel x:Name="ModsSection" Spacing="10" Margin="0,4,0,0">
                    <MenuFlyoutSeparator Margin="0,4,0,4"/>
                    <TextBlock Text="??? ????????? ??????????? (??????????? ? ????????? ? ????????????)" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>

                    <StackPanel x:Name="RomFsNamePanel" Spacing="4">
                        <TextBlock Text="???????? RomFS ??????????? (?????)" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="ModRomFsBox" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel x:Name="ExeFsNamePanel" Spacing="4">
                        <TextBlock Text="???????? ExeFS / IPS ??????????? (?????)" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox x:Name="ModExeFsBox" CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ????????? -->
            <TextBlock Grid.Row="5" Text="?? ??? Switch ????????? ????????? ? Control NCA (NACP + 256x256 JPEG). ??? 3DS ????????????? ?????????? 16-???????? SMDH (48x48 + 24x24 Morton RGB565) ? ???????? ????? CWAV ? banner.bin."
                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</ContentDialog>
