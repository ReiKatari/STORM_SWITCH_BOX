<ContentDialog
    x:Class="StormSwitchBox.Views.Dialogs.ControlEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Редактор метаданных и иконки игры"
    PrimaryButtonText="Сохранить"
    CloseButtonText="Отмена"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="8"
    Width="560">

    <Grid RowSpacing="16" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя секция: Иконка + Title ID / Версия -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка с зоной Drag-and-Drop -->
            <Border Grid.Column="0" Width="128" Height="128" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                    Background="#1E293B" AllowDrop="True"
                    DragOver="IconDropArea_DragOver" Drop="IconDropArea_Drop"
                    ToolTipService.ToolTip="Перетащите новое изображение (PNG/JPEG) или нажмите кнопку ниже">
                <Grid>
                    <Image x:Name="GameIconImage" Stretch="UniformToFill" Width="124" Height="124"/>
                    <Border Background="#99000000" VerticalAlignment="Bottom" Height="28">
                        <TextBlock Text="Перетащите фото" FontSize="10" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Инфо и кнопка выбора иконки -->
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Title ID:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TitleIdText" Text="0100000000000000" FontFamily="Consolas" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Версия:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="VersionText" Text="1.0.0" FontWeight="Bold"/>
                </StackPanel>

                <Button Content="📁 Выбрать иконку (PNG/JPG)" Click="SelectIconButton_Click" 
                        CornerRadius="4" Margin="0,4,0,0"/>
                <Button Content="🔄 Сбросить к оригиналу" Click="ResetIconButton_Click" 
                        CornerRadius="4" FontSize="11" Background="Transparent" BorderThickness="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Разделитель -->
        <MenuFlyoutSeparator Grid.Row="1"/>

        <!-- Поля ввода названий -->
        <StackPanel Grid.Row="2" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Название игры (English / Основное)" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="TitleEnglishBox" PlaceholderText="Например: Mortal Kombat 1" CornerRadius="4"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Название игры (Русский)" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="TitleRussianBox" PlaceholderText="Например: Mortal Kombat 1 [RUS]" CornerRadius="4"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Издатель / Разработчик" FontSize="12" FontWeight="SemiBold"/>
                <TextBox x:Name="PublisherBox" PlaceholderText="Например: Warner Bros. Games" CornerRadius="4"/>
            </StackPanel>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3" Text="💡 Изменения будут вшиты в Control NCA (NACP + иконка) при следующей сборке игры."
                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</ContentDialog>
