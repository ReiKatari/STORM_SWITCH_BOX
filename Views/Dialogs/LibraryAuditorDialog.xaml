<ContentDialog
    x:Class="StormSwitchBox.Views.Dialogs.LibraryAuditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:StormSwitchBox.Services"
    mc:Ignorable="d"
    Title="??? ??????? ? ???????????? ????????? ??? (Library Health &amp; Space Saver)"
    CloseButtonText="???????"
    CornerRadius="8"
    MinWidth="1040"
    MaxWidth="1260">

    <Grid RowSpacing="12" Margin="0,6,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ????? ?????????? ?????????? -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LibraryPathBox" Grid.Column="0" PlaceholderText="???? ? ????? ????????? ??? Switch ? 3DS (.nsp, .nsz, .xci, .xcz, .3ds, .cci, .cia)" CornerRadius="4"/>
            <Button Grid.Column="1" Content="?? ?????..." Click="BrowseFolder_Click" CornerRadius="4"/>
            <Button x:Name="ScanButton" Grid.Column="2" Content="?? ??????????? ?????????" Click="ScanLibrary_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="4"/>
        </Grid>

        <!-- ???????? ?????????? -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="?????????????? ??????" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CardTotalFiles" Text="0" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="????? ?????? ?????????" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CardTotalSize" Text="0 ?" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="????????????? ????????" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CardPotentialSavings" Text="~0 ?" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="??????? ???????????" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="CardIssuesCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ?????? ???????????? -->
        <Border Grid.Row="2" Background="#14FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
            <ListView x:Name="IssuesListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:LibraryAuditIssue">
                        <Grid ColumnSpacing="10" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="28"/>
                            <Border Grid.Column="1" Background="#220284C7" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Platform}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{x:Bind IssueLabel}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FBBF24"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind GameName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind PrimaryFile}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind Recommendation}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Recommendation}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind SavingsFormatted}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ?????? ??????? ???????? ? 1 ???? -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="?? ? ???????? (????? / ????? ?????????)" Click="SendToTasks_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="4"/>
            <Button Grid.Column="1" Content="?? ???????? XCI/3DS ? ?????????? 3DS" Click="QuickTrimAndDecrypt_Click" CornerRadius="4"/>
            <Button Grid.Column="2" Content="??? ??????? ????????? ?????? ??????" Click="DeleteSupersededPatches_Click" CornerRadius="4"/>
            <Button Grid.Column="4" Content="?? ??????? ?????? (.TXT)" Click="ExportReport_Click" CornerRadius="4"/>
        </Grid>

        <!-- ?????? -->
        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0" Height="6"/>
            <TextBlock x:Name="StatusText" Text="???????? ????? ? ?????? Switch / 3DS ? ??????? ???????????? ??????????." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</ContentDialog>
