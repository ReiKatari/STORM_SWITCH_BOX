<ContentDialog
    x:Class="StormSwitchBox.Views.Dialogs.ErrorCodesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="None"
    Background="Transparent"
    BorderThickness="0"
    CornerRadius="14"
    KeyDown="Dialog_KeyDown">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1220</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
    </ContentDialog.Resources>

    <Border x:Name="RootFrame"
            Width="980"
            Height="680"
            CornerRadius="14"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="HeaderBanner"
                    Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="22,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            CornerRadius="10"
                            Background="#24F59E0B"
                            BorderBrush="#55F59E0B"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText"
                                   Text="Справочник системных кодов ошибок Switch и Atmosphère (2xxx-xxxx)"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DialogSubtitleText"
                                   Text="Быстрый поиск по коду, модулю Horizon OS или симптому с готовыми решениями"
                                   FontSize="12.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ResultsCountText"
                                   Text="10 / 10"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <Button x:Name="TopCloseButton"
                            Grid.Column="3"
                            Click="CloseDialog_Click"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Закрыть">
                        <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Search and Category Filters -->
            <Grid x:Name="ToolbarPanel" Grid.Row="1" Padding="22,14,22,10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="40">
                    <TextBox x:Name="ErrorSearchBox"
                             PlaceholderText="Введите код ошибки (напр. 2002-4153, 2168-0002, 2016-0641) или симптом..."
                             TextChanged="ErrorSearchBox_TextChanged"
                             CornerRadius="8"
                             Padding="38,8,12,8"
                             Height="40"
                             HorizontalAlignment="Stretch"/>
                    <FontIcon Glyph="&#xE721;"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Left"
                              Margin="14,0,0,0"
                              IsHitTestVisible="False"/>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FilterAllButton"
                                Tag="all"
                                Content="Все коды"
                                Click="CategoryFilter_Click"
                                Height="32"
                                Padding="14,0"
                                CornerRadius="8"
                                Background="{ThemeResource AccentButtonBackground}"
                                Foreground="{ThemeResource AccentButtonForeground}"
                                FontWeight="SemiBold"/>
                        <Button x:Name="FilterFsButton"
                                Tag="fs"
                                Content="Файлы и SD"
                                Click="CategoryFilter_Click"
                                Height="32"
                                Padding="14,0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold"/>
                        <Button x:Name="FilterCrashButton"
                                Tag="crash"
                                Content="Вылеты и моды"
                                Click="CategoryFilter_Click"
                                Height="32"
                                Padding="14,0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold"/>
                        <Button x:Name="FilterKeysButton"
                                Tag="keys"
                                Content="Подписи и ключи"
                                Click="CategoryFilter_Click"
                                Height="32"
                                Padding="14,0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold"/>
                        <Button x:Name="FilterNetButton"
                                Tag="net"
                                Content="Сеть и блокировки"
                                Click="CategoryFilter_Click"
                                Height="32"
                                Padding="14,0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Cards List and Empty State -->
            <ScrollViewer Grid.Row="2" Padding="22,2,22,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="CardsHostPanel" Spacing="10"/>

                    <StackPanel x:Name="EmptyStatePanel"
                                Visibility="Collapsed"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                Margin="0,48,0,48">
                        <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateText"
                                   Text="По вашему запросу коды ошибок не найдены"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="ResetFilterButton"
                                Content="Сбросить поиск"
                                Click="ResetFilter_Click"
                                CornerRadius="8"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border x:Name="FooterPanel"
                    Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="22,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterTipText"
                               Grid.Column="0"
                               Text="Используйте поиск по номеру ошибки (например 2002-4153) или копируйте готовую инструкцию прямо из карточки."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Button x:Name="FooterCloseButton"
                            Grid.Column="1"
                            Content="Закрыть"
                            Click="CloseDialog_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="36"
                            Padding="24,0"
                            CornerRadius="8"
                            FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ContentDialog>
