<Page
    x:Class="StormSwitchBox.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSwitchBox.Views"
    xmlns:models="using:StormSwitchBox.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="LogListItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,-2,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="20" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop" DragLeave="Grid_DragLeave" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="LogRow" Height="130"/>
        </Grid.RowDefinitions>
        
        <!-- ========== ТУЛБАР ========== -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,6">
            <AppBarButton x:Name="AddButton" Label="Добавить">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE896;" Foreground="#2ECC71"/>
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="AddFilesItem" Text="Добавить файлы..." Click="AddFiles_Click"/>
                        <MenuFlyoutItem x:Name="AddFolderItem" Text="Добавить папку..." Click="AddFolder_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarElementContainer VerticalAlignment="Center" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="PlatformToggle_Click" Padding="8,5" CornerRadius="6"
                            ToolTipService.ToolTip="Переключить платформу (Switch / 3DS)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7FC;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPlatformLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="FormatComboBox" SelectedIndex="{x:Bind ViewModel.SelectedFormatIndex, Mode=TwoWay}" Width="90" 
                              SelectionChanged="FormatComboBox_SelectionChanged"
                              ToolTipService.ToolTip="Выходной формат для Switch"
                              Visibility="{x:Bind ViewModel.IsSwitchPlatformVisible, Mode=OneWay}">
                        <ComboBoxItem Content="NSP"/>
                        <ComboBoxItem Content="NSZ"/>
                        <ComboBoxItem Content="XCI"/>
                        <ComboBoxItem Content="XCZ"/>
                    </ComboBox>
                    <ComboBox x:Name="FormatComboBox3ds" SelectedIndex="{x:Bind ViewModel.SelectedFormatIndex3ds, Mode=TwoWay}" Width="95" 
                              SelectionChanged="FormatComboBox3ds_SelectionChanged"
                              ToolTipService.ToolTip="Выходной формат для 3DS"
                              Visibility="{x:Bind ViewModel.Is3dsPlatformVisible, Mode=OneWay}">
                        <ComboBoxItem Content="3DS"/>
                        <ComboBoxItem Content="CIA"/>
                        <ComboBoxItem Content="CXI"/>
                    </ComboBox>
                </StackPanel>
            </AppBarElementContainer>
            <AppBarButton x:Name="StartAllButton" Label="Запустить всё" Command="{x:Bind ViewModel.StartAllTasksCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" Foreground="#00E5FF"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="StopAllButton" Label="Остановить" Command="{x:Bind ViewModel.StopAllTasksCommand}" IsEnabled="{x:Bind ViewModel.IsAnyTaskRunning, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73B;" Foreground="#FFC107"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CollapseAllButton" Label="Свернуть все" Click="CollapseAll_Click" ToolTipService.ToolTip="Закрыть детальную информацию у всех задач">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A0;" Foreground="#B388FF"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Name="ColumnsButton" Label="Столбцы">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B3;" Foreground="#536DFE"/>
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ColumnsFlyoutTitle" Text="Отображение столбцов" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <CheckBox Content="Обработка" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="2"/>
                            <CheckBox Content="Нач. формат" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="3"/>
                            <CheckBox Content="Кон. формат" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="4"/>
                            <CheckBox Content="Нач. размер" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="5"/>
                            <CheckBox Content="Кон. размер" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="6"/>
                            <CheckBox Content="Разница" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="7"/>
                            <CheckBox Content="Сжатие" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="8"/>
                            <CheckBox Content="Файлы" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="9"/>
                            <CheckBox Content="RomFS" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="10"/>
                            <CheckBox Content="ExeFS" IsChecked="True" Checked="ColumnVisibility_Checked" Unchecked="ColumnVisibility_Unchecked" Tag="11"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Name="ClearButton" Label="Очистить" Command="{x:Bind ViewModel.ClearTasksCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" Foreground="#FF5252"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarElementContainer VerticalAlignment="Center">
                <TextBox x:Name="TaskSearchBox" PlaceholderText="🔍 Поиск..." Width="200" Height="30" 
                         TextChanged="TaskSearchBox_TextChanged" VerticalContentAlignment="Center" FontSize="11" CornerRadius="4"/>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalAlignment="Center" Margin="4,0">
                <ComboBox x:Name="TaskOpFilter" PlaceholderText="Фильтр" Width="130" Height="30"
                          SelectionChanged="TaskOpFilter_Changed" VerticalContentAlignment="Center" FontSize="11" CornerRadius="4">
                    <ComboBoxItem Content="Все" Tag=""/>
                    <ComboBoxItem Content="Обновление" Tag="Update"/>
                    <ComboBoxItem Content="Распаковка" Tag="Unpack"/>
                    <ComboBoxItem Content="Упаковка" Tag="Pack"/>
                    <ComboBoxItem Content="Конвертация" Tag="Convert"/>
                    <ComboBoxItem Content="Мульти-контент" Tag="Multi"/>
                    <ComboBoxItem Content="Проверка" Tag="Verify"/>
                </ComboBox>
            </AppBarElementContainer>
        </CommandBar>

        <Grid Grid.Row="1" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid.Resources>
                <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#20FFFFFF"/>
                <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#25FFFFFF"/>
                <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#30FFFFFF"/>
                <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#30FFFFFF"/>
            </Grid.Resources>
            
            <controls:DataGrid x:Name="TasksGrid" ItemsSource="{x:Bind ViewModel.Tasks}"
                               AutoGenerateColumns="False"
                               GridLinesVisibility="All"
                               HeadersVisibility="Column"
                               RowDetailsVisibilityMode="Collapsed"
                               SelectionMode="Single"
                               Background="Transparent"
                               CanUserSortColumns="False"
                               CanUserReorderColumns="False"
                               RowHeight="88"
                               HorizontalScrollBarVisibility="Auto"
                               Tapped="DataGrid_Tapped"
                               PointerPressed="TasksGrid_PointerPressed"
                               SelectionChanged="TasksGrid_SelectionChanged">

                <controls:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="primitives:DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               Foreground="White" FontWeight="Bold" FontSize="11" CharacterSpacing="80"
                                               TextTrimming="None" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:DataGrid.ColumnHeaderStyle>
                
                <controls:DataGrid.Columns>
                    <controls:DataGridTemplateColumn Header="Иконка" Width="150" MinWidth="80" IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:ProcessingTask">
                                <Image Source="{x:Bind GameIcon, Mode=OneWay}" Width="76" Height="76" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    
                    <controls:DataGridTemplateColumn Header="Задача" Width="400" MinWidth="150" IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OutputFileName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    
                    <controls:DataGridTextColumn Header="Обработка" Binding="{Binding OperationDisplay}" IsReadOnly="True" Width="250" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    
                    <controls:DataGridTextColumn Header="Нач. формат" Binding="{Binding SourceFormat}" IsReadOnly="True" Width="150" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    
                    <controls:DataGridTemplateColumn Header="Кон. формат" Width="150" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableTargetFormats}"
                                          SelectedItem="{Binding TargetFormat, Mode=TwoWay}" 
                                          IsEnabled="{Binding CanChangeFormat, Mode=OneWay}" 
                                          Foreground="{Binding TargetFormatColor, Mode=OneWay}"
                                          FontWeight="{Binding TargetFormatWeight, Mode=OneWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Padding="6,2" MinWidth="65" MinHeight="26" Height="26" BorderThickness="0" Background="Transparent">
                                </ComboBox>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTextColumn Header="Нач. размер" Binding="{Binding SourceSize}" IsReadOnly="True" Width="150" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Кон. размер" Binding="{Binding TargetSize}" IsReadOnly="True" Width="150" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Разница" Binding="{Binding SizeDifference}" IsReadOnly="True" Width="200" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Сжатие" Binding="{Binding CompressionLevel}" IsReadOnly="True" Width="100" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    
                    <controls:DataGridTemplateColumn Header="Файлы" Width="100" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="FilesCount_Click" Tag="{Binding}" 
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Padding="10,4" MinHeight="28" MinWidth="36"
                                        Background="#2A3A5C" BorderBrush="#4A6FA5" BorderThickness="1" CornerRadius="6"
                                        ToolTipService.ToolTip="Показать список файлов">
                                    <TextBlock Text="{Binding FilesCount}" FontWeight="Bold" FontSize="14" Foreground="#82B1FF"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTextColumn Header="RomFS" Binding="{Binding HasRomFs}" IsReadOnly="True" Width="100" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="ExeFS" Binding="{Binding HasExeFs}" IsReadOnly="True" Width="100" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>

                    <controls:DataGridTemplateColumn Header="Статус" Width="200" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                    <ProgressRing IsActive="{Binding IsRunning}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <Border Background="{Binding StatusColor}" CornerRadius="6" Padding="12,4">
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Выполнение" Width="200" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0" VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{Binding StatusColor}" Height="6" CornerRadius="3"/>
                                    <TextBlock Text="{Binding Speed}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,4,0" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Width="80" MinWidth="60">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Click="EditMetadata_Click" Tag="{Binding}" VerticalAlignment="Center"
                                            Padding="4,2" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" 
                                            ToolTipService.ToolTip="Редактировать иконку и название игры">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="#82B1FF"/>
                                    </Button>

                                    <Button Click="CancelTask_Click" Tag="{Binding}" VerticalAlignment="Center"
                                            Visibility="{Binding IsRunning, Mode=OneWay}"
                                            Padding="4,2" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" 
                                            ToolTipService.ToolTip="Отменить задачу">
                                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#F59E0B"/>
                                    </Button>

                                    <Button Click="DeleteTask_Click" Tag="{Binding}" VerticalAlignment="Center"
                                            Visibility="{Binding IsNotRunning, Mode=OneWay}"
                                            Padding="4,2" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" 
                                            ToolTipService.ToolTip="Удалить задачу">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="IndianRed"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>

                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="MinWidth" Value="320"/>
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                        <MenuFlyoutItem Text="Редактировать иконку и название..." Click="EditMetadata_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" Foreground="#82B1FF"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Отменить выполнение задачи" Click="CancelTask_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71A;" Foreground="#F59E0B"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Удалить задачу из списка" Click="DeleteTask_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="IndianRed"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Открыть выходную папку" Click="OpenOutputFolder_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED25;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Копировать журнал (лог)" Click="CopyLog_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>
            </controls:DataGrid>

            <!-- ========== ТАБЛИЦА ВЕРИФИКАЦИИ (РАЗДЕЛ ПРОВЕРКА) ========== -->
            <controls:DataGrid x:Name="VerifyGrid"
                               AutoGenerateColumns="False"
                               GridLinesVisibility="All"
                               HeadersVisibility="Column"
                               RowDetailsVisibilityMode="Collapsed"
                               SelectionMode="Single"
                               Background="Transparent"
                               CanUserSortColumns="False"
                               CanUserReorderColumns="False"
                               RowHeight="88"
                               HorizontalScrollBarVisibility="Auto"
                               Tapped="DataGrid_Tapped"
                               PointerPressed="TasksGrid_PointerPressed"
                               SelectionChanged="TasksGrid_SelectionChanged"
                               Visibility="Collapsed">

                <controls:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="primitives:DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               Foreground="White" FontWeight="Bold" FontSize="11" CharacterSpacing="80"
                                               TextTrimming="None" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:DataGrid.ColumnHeaderStyle>

                <controls:DataGrid.Columns>
                    <controls:DataGridTemplateColumn Header="Иконка" Width="150" MinWidth="80" IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:ProcessingTask">
                                <Image Source="{x:Bind GameIcon, Mode=OneWay}" Width="76" Height="76" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Файл" Width="400" MinWidth="150" IsReadOnly="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OutputFileName}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTextColumn Header="Размер" Binding="{Binding SourceSize}" IsReadOnly="True" Width="150" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Тип контента" Binding="{Binding VerifyType}" IsReadOnly="True" Width="200" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Title ID" Binding="{Binding VerifyTitleId}" IsReadOnly="True" Width="200" MinWidth="50" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Версия" Binding="{Binding VerifyVersion}" IsReadOnly="True" Width="150" MinWidth="40" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Структура" Binding="{Binding VerifyStructure}" IsReadOnly="True" Width="300" MinWidth="100" ElementStyle="{StaticResource CenterAlignedCell}"/>
                    <controls:DataGridTextColumn Header="Сшит правильно" Binding="{Binding VerifyMergedStatus}" IsReadOnly="True" Width="150" MinWidth="80" ElementStyle="{StaticResource CenterAlignedCell}"/>

                    <controls:DataGridTemplateColumn Header="Статус" Width="200" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                                    <ProgressRing IsActive="{Binding IsRunning}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <Border Background="{Binding StatusColor}" CornerRadius="6" Padding="12,4">
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Выполнение" Width="200" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0" VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{Binding StatusColor}" Height="6" CornerRadius="3"/>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="45" MinWidth="40">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeleteTask_Click" Tag="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Padding="4,2" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Удалить задачу">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="IndianRed"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>

                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="MinWidth" Value="320"/>
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                        <MenuFlyoutItem Text="Удалить задачу из списка" Click="DeleteTask_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="IndianRed"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Копировать журнал (лог)" Click="CopyLog_Click" MinWidth="300">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>
            </controls:DataGrid>
        </Grid>

        <Thumb x:Name="LogResizerThumb" Grid.Row="2" Height="16" HorizontalAlignment="Stretch" Margin="0,-2"
               DragDelta="LogResizer_DragDelta" DragCompleted="LogResizer_DragCompleted"
               PointerEntered="LogResizerThumb_PointerEntered" PointerExited="LogResizerThumb_PointerExited"
               ToolTipService.ToolTip="Потяните вверх или вниз, чтобы изменить размер журнала">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="#01000000"> <!-- Almost transparent to ensure hit testing -->
                        <Border Height="4" Width="40" Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" VerticalAlignment="Top"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ========== ПАНЕЛЬ ДЕТАЛЕЙ И ЛОГОВ (Tabbed Pivot) ========== -->
        <Border Grid.Row="3" Margin="0,4,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Pivot x:Name="DetailsPivot" Padding="0">
                <!-- Вкладка 1: Журнал событий -->
                <PivotItem Header="📋 Журнал событий">
                    <Grid Padding="12,4,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                          <Grid Grid.Row="0" Margin="0,4,0,8">
                              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                                  <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#82B1FF" VerticalAlignment="Center"/>
                                  <TextBlock Text="ПОЛНЫЙ ЖУРНАЛ СОБЫТИЙ" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" CharacterSpacing="120"/>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                  <Button Content="🗑️ Очистить" Click="ClearLogs_Click" Padding="8,4" FontSize="11" CornerRadius="4" ToolTipService.ToolTip="Очистить журнал"/>
                                  <Button Content="📋 Копировать" Click="CopyLogs_Click" Padding="8,4" FontSize="11" CornerRadius="4" ToolTipService.ToolTip="Скопировать все логи в буфер обмена"/>
                              </StackPanel>
                          </Grid>
                        <ListView x:Name="LogsListView" Grid.Row="1" ItemsSource="{x:Bind AppLogs}" SelectionMode="None"
                                  ItemContainerStyle="{StaticResource LogListItem}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LogMessage">
                                    <Grid Margin="0,1" Padding="4,3" Background="{x:Bind RowBackground}" CornerRadius="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Бейдж уровня -->
                                        <Border Grid.Column="0" Background="{x:Bind LevelBadgeBackground}" CornerRadius="3" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="46">
                                            <TextBlock Text="{x:Bind LevelLabel}" Foreground="{x:Bind LevelBadgeForeground}" FontFamily="Consolas" FontSize="9" FontWeight="Bold" HorizontalTextAlignment="Center"/>
                                        </Border>
                                        <!-- Иконка -->
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind LevelIcon}" FontSize="11" Foreground="{x:Bind LevelBadgeForeground}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <!-- Время -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
                                        <!-- Сообщение -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind Message}" Foreground="{x:Bind ColorBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>
                
                <!-- Вкладка 2: Детали и лог задачи -->
                <PivotItem Header="⚙️ Параметры и Лог задачи">
                    <Grid DataContext="{Binding ElementName=TasksGrid, Path=SelectedItem}" Padding="12,8">
                        <!-- Если ничего не выбрано, показываем плейсхолдер -->
                        <StackPanel x:Name="NoSelectionPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Выберите задачу в таблице для просмотра параметров и лога" 
                                       HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" FontStyle="Italic" Opacity="0.7"/>
                        </StackPanel>
                        
                        <!-- Если задача выбрана, показываем детали -->
                        <Grid x:Name="DetailsContainer" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ParamsColumn" Width="680"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Левая колонка: параметры -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                                <StackPanel Spacing="10" Padding="0,0,0,4">
                                    <!-- Заголовок -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#82B1FF"/>
                                        <TextBlock Text="ПАРАМЕТРЫ ЗАДАЧИ" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" CharacterSpacing="120"/>
                                    </StackPanel>
                                    
                                    <!-- Карточка: Входные файлы -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="#64B5F6" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Column="1" Text="Входные файлы:" FontWeight="SemiBold" Foreground="#82B1FF" FontSize="11" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding InputFolders}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Карточка: Выходная папка -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8DA;" FontSize="16" Foreground="#FFB74D" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Выходная папка:" FontWeight="SemiBold" Foreground="#FFB74D" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="11" IsEnabled="{Binding IsNotRunning, Mode=OneWay}" Height="28" MinHeight="0" Padding="6,2"
                                                     VerticalContentAlignment="Center"
                                                     AllowDrop="True" DragOver="OutputFolder_DragOver" Drop="OutputFolder_Drop"
                                                     PlaceholderText="Путь или перетащите папку"/>
                                            <Button Grid.Column="3" Content="📂 Обзор" Click="BrowseOutputFolder_Click" Tag="{Binding}" FontSize="10" Padding="8,2" Height="28" IsEnabled="{Binding IsNotRunning, Mode=OneWay}" CornerRadius="4"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Карточка: Имя файла -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="16" Foreground="#81C784" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Имя файла:" FontWeight="SemiBold" Foreground="#81C784" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2" Text="{Binding OutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="11" AllowDrop="True" DragOver="OutputName_DragOver" Drop="OutputName_Drop" Foreground="#81C784" Height="28" MinHeight="0" Padding="6,2" VerticalContentAlignment="Center" IsEnabled="{Binding IsNotRunning, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <!-- Правая колонка: лог выполнения -->
                            <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Заголовок лога -->
                                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="#82B1FF"/>
                                        <TextBlock Text="ЛОГ ВЫПОЛНЕНИЯ" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" CharacterSpacing="100"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer x:Name="TaskLogScrollViewer" Grid.Row="1" Padding="10,6" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LogDetails}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" IsTextSelectionEnabled="True" SizeChanged="TaskLogTextBlock_SizeChanged"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Border>
        
        <!-- Оверлей при перетаскивании -->
        <Border x:Name="DropOverlay" Background="#80000000" CornerRadius="8" Visibility="Collapsed" Grid.RowSpan="4" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <FontIcon Glyph="&#xE8B5;" FontSize="64" Foreground="White"/>
                <TextBlock Text="Отпустите файлы для добавления" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Оверлей при загрузке файлов -->
        <Border x:Name="LoadingOverlay" Background="#80000000" CornerRadius="8" Visibility="Collapsed" Grid.RowSpan="4" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="64" Height="64" Foreground="LightSkyBlue"/>
                <TextBlock Text="Загрузка и анализ файлов..." FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
