<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\..\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StormInstaller</AssemblyName>
    <AssemblyTitle>STORM SWITCH BOX</AssemblyTitle>
    <Title>STORM SWITCH BOX</Title>
    <RootNamespace>StormSwitchBox.Installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>8.2.5</Version>
    <AssemblyVersion>8.2.5.0</AssemblyVersion>
    <FileVersion>8.2.5.0</FileVersion>
    <Product>STORM SWITCH BOX</Product>
    <Company>STORM TEAM</Company>
    <Copyright>Copyright © 2026 STORM TEAM. All rights reserved.</Copyright>
    <Description>STORM SWITCH BOX</Description>
    <NoWarn>$(NoWarn);WFO1000;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Files\STORM_SWITCH_BOX_$(Version)_win-x64.zip" Link="Payload.zip" Condition="Exists('..\..\Files\STORM_SWITCH_BOX_$(Version)_win-x64.zip')" />
    <EmbeddedResource Include="..\..\installer\Output\STORM_SWITCH_BOX_$(Version).zip" Link="Payload.zip" Condition="!Exists('..\..\Files\STORM_SWITCH_BOX_$(Version)_win-x64.zip') and Exists('..\..\installer\Output\STORM_SWITCH_BOX_$(Version).zip')" />
    <EmbeddedResource Include="..\..\Assets\AppIcon.ico" Link="app.ico" />
    <EmbeddedResource Include="$(STORM_CERT_PATH)" Link="STORM_CERTIFICATE.cer" Condition="'$(STORM_CERT_PATH)' != '' and Exists('$(STORM_CERT_PATH)')" />
    <EmbeddedResource Include="..\STORM_Certificate.cer" Link="STORM_CERTIFICATE.cer" Condition="('$(STORM_CERT_PATH)' == '' or !Exists('$(STORM_CERT_PATH)')) and Exists('..\STORM_Certificate.cer')" />
    <EmbeddedResource Include="..\..\bin\Release\net8.0-windows10.0.19041.0\win-x64\STORM_Certificate.cer" Link="STORM_CERTIFICATE.cer" Condition="('$(STORM_CERT_PATH)' == '' or !Exists('$(STORM_CERT_PATH)')) and !Exists('..\STORM_Certificate.cer') and Exists('..\..\bin\Release\net8.0-windows10.0.19041.0\win-x64\STORM_Certificate.cer')" />
  </ItemGroup>

</Project>
