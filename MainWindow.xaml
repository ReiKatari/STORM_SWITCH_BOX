<Window
    x:Class="StormSwitchBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSwitchBox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="MainNavigation" PaneDisplayMode="Left" OpenPaneLength="220" SelectionChanged="MainNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavUpdateItem" Icon="Refresh" Content="Обновление" Tag="Update" />
                <NavigationViewItem x:Name="NavUnpackItem" Icon="Download" Content="Распаковка" Tag="Unpack" />
                <NavigationViewItem x:Name="NavPackItem" Icon="Save" Content="Упаковка" Tag="Pack" />
                <NavigationViewItem x:Name="NavConvertItem" Icon="Switch" Content="Конвертация" Tag="Convert" />
                <NavigationViewItem x:Name="NavMultiItem" Icon="Library" Content="Мульти-контент" Tag="Multi" />
                
                <NavigationViewItemSeparator />
                
                <NavigationViewItem x:Name="NavVerifyItem" Icon="Accept" Content="Проверка" Tag="Verify" />
            </NavigationView.MenuItems>
            
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavInstructionItem" Icon="Document" Content="Инструкция" Tag="Instruction" />
                <NavigationViewItem x:Name="NavGameLibraryItem" Icon="AllApps" Content="Библиотека игр" Tag="GameLibrary" />
                <NavigationViewItem x:Name="NavCatalogItem" Icon="Pictures" Content="Информация" Tag="Catalog" />
                <NavigationViewItem x:Name="NavHistoryItem" Icon="Clock" Content="История" Tag="History" />
            </NavigationView.FooterMenuItems>
            
            <Frame x:Name="ContentFrame" Padding="0,32,0,0">
                <!-- Содержимое будет загружаться динамически из MainWindow.xaml.cs -->
            </Frame>
        </NavigationView>

        <!-- Single Instance / App Alert Overlay -->
        <InfoBar x:Name="GlobalAlertInfoBar"
                 IsOpen="False"
                 Severity="Informational"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 Margin="0,42,0,0"
                 Canvas.ZIndex="999"
                 CornerRadius="8"
                 Background="#1E293B"
                 BorderBrush="#0EA5E9"
                 BorderThickness="1"
                 Foreground="#F8FAFC"/>
    </Grid>
</Window>
